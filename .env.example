APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL is baked into every uploaded image URL (MediaService::store()), so it
# must be the exact scheme://host:port this API is reached on — and the same
# host the frontend's NEXT_PUBLIC_API_ORIGIN uses. Locally use `localhost`
# (not 127.0.0.1) on both sides: cookies ignore ports, so localhost:8000 and
# localhost:3000 share the session Google sign-in creates. Production:
# APP_URL=https://api.zurie.co.tz
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# VAT (config/zurie.php). Rate applied to every product not marked
# "VAT exempted". ZURIE_PRICES_INCLUDE_VAT=true means the prices you enter
# already contain VAT (a 45,000 item costs 45,000); false adds VAT on top
# (45,000 + 18%). Changing it only affects new orders.
ZURIE_DEFAULT_VAT_PERCENTAGE=18
ZURIE_PRICES_INCLUDE_VAT=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_TIMEZONE=Africa/Dar_es_Salaam

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=daily and LOG_LEVEL=warning (single file + debug level grows without bound).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zurie_backend_v1
DB_USERNAME=root
DB_PASSWORD=

# backup:verify-restore (weekly) restores the latest backup into a scratch
# database. On cPanel the DB user can't CREATE DATABASE, so create one spare
# database in cPanel, add this app's DB user to it with ALL PRIVILEGES, and
# name it here. It is emptied after every check. Never the live database.
# BACKUP_VERIFY_DATABASE=zuricom_restore_check

# Scaling: at real traffic move SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION to `redis`
# (database drivers add a query to every request and contend on one MySQL) —
# verified working end-to-end against a real Redis instance (cache, session-
# capable driver, and queue push/pop all round-tripped correctly through the
# `predis` client below, since this app's shared-hosting deploy target can't
# install the phpredis PHP extension). Nothing else needs to change in code.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Google sign-in logs the customer in on the API host (its callback is a
# browser navigation to APP_URL), but the storefront reads the session
# through its own origin's /api/v1 proxy. The two only share that cookie if
# it's scoped to the parent domain. Production: SESSION_DOMAIN=.zurie.co.tz
# Local (both on localhost): leave null.
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,zurie.co.tz,www.zurie.co.tz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000,https://zurie.co.tz

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Google OAuth (customer sign-in). The redirect URI must be listed verbatim
# under "Authorized redirect URIs" in Google Cloud Console. Both
# /api/v1/customer/auth/google/callback and the older
# /api/v1/auth/google/callback path are served.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/customer/auth/google/callback"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (a pure-PHP client, `composer require predis/predis` — already in
# composer.json) not phpredis — this app's shared-hosting deploy target
# can't install PHP extensions. Don't change REDIS_CLIENT to phpredis
# unless that extension is actually confirmed installed on the target host.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real provider readiness (no code change needed — config/mail.php already
# defines smtp/ses/postmark/resend): set MAIL_MAILER to one of those and
# fill its credentials below before going live. `log` (current default)
# only writes emails to the log file — nothing is actually sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage for product/category image uploads. Filling these and
# setting MEDIA_DISK=s3 (see config/filesystems.php) moves uploads to S3
# with no code change — verified end-to-end (upload + delete) against the
# local disk this session; the S3 path uses the same MediaService code,
# just a different Storage::disk() target.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# MEDIA_DISK=s3

# Error monitoring — a no-op until this is set (see bootstrap/app.php and
# config/sentry.php). Get a DSN from sentry.io (free tier is enough to
# start) and set it here to have every uncaught exception reported there
# instead of only sitting in storage/logs/laravel.log where nobody's
# watching. SENTRY_TRACES_SAMPLE_RATE is optional performance tracing —
# leave unset (errors-only) until you've confirmed the error reporting
# itself works.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
# SENTRY_TRACES_SAMPLE_RATE=0.1

VITE_APP_NAME="${APP_NAME}"
